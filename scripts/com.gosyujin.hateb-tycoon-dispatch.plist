<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gosyujin.hateb-tycoon-dispatch</string>
    <key>Description</key><string>hateb-tycoon の GitHub Actions (hotentry-sync.yml) を15分ごとに手動起動して、はてブの人気エントリを同期する</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/kk/github/hateb-tycoon/scripts/hateb-tycoon-dispatch.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Minute</key>
            <integer>45</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/kk/Library/Logs/hateb-tycoon-dispatch-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kk/Library/Logs/hateb-tycoon-dispatch-launchd.log</string>
</dict>
</plist>
